{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "outDir": "./output",
        "sourceMap": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitOverride": false,
        "strictNullChecks": true,
        "strictPropertyInitialization": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js"
    ],
    "exclude": [
        "output/**/*.*"
    ]
}